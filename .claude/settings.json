{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "120000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/cupcake-hook.sh",
            "type": "command"
          },
          {
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/er-stale-run-sentinel.sh hook",
            "type": "command"
          }
        ],
        "matcher": "Edit|MultiEdit|Write"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/beads-prime.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/cupcake-hook.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/beads-prime.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/cupcake-hook.sh",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/cupcake-hook.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/cupcake-hook.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}
