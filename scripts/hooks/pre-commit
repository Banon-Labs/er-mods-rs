#!/usr/bin/env bash
# Fast static guards for the normal rust build/format/commit cycle (bd
# static-guards-run-in-build-format-cycle-precommit-hook-2026-07-19). Runs the quick,
# source-only checks so hidden feature toggles (marker files / env vars), lossy UTF-8, and
# unbounded timeouts are caught BEFORE they land -- without the slow windows cargo check / tests
# that scripts/check.sh runs. Install with: bash scripts/install-git-hooks.sh
#
# Bypass for an emergency commit: `git commit --no-verify` (use sparingly, then fix + re-run check.sh).
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
	echo "pre-commit: not in a git repo; skipping" >&2
	exit 0
}
cd "$repo_root" || exit 0

# Only run when the commit actually touches rust source or the scripts/policies that gate it, so a
# docs- or beads-only commit is not slowed down.
staged="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)"
if ! grep -qE '\.rs$|^scripts/|^\.auto/|^\.cupcake/' <<<"$staged"; then
	exit 0
fi

fail=0
run() {
	local label="$1"
	shift
	if ! "$@" >/tmp/precommit-$$.log 2>&1; then
		echo "pre-commit: FAIL [$label]" >&2
		sed 's/^/    /' /tmp/precommit-$$.log >&2
		fail=1
	fi
	rm -f /tmp/precommit-$$.log
}

# Fast source-only guards (each is a static scan; all finish in well under a second).
run "marker-file-gates" python3 scripts/check-marker-file-gates.py
run "env-gate-comments" python3 scripts/check-env-gate-comments.py
[[ -f scripts/check-no-lossy-utf8.py ]] && run "no-lossy-utf8" python3 scripts/check-no-lossy-utf8.py
[[ -f scripts/check-no-timeouts.py ]] && run "no-timeouts" python3 scripts/check-no-timeouts.py
# A test scratch path under `std::env::temp_dir()` with no per-process component. This one belongs
# in the COMMIT cycle rather than only in check.sh: the defect is invisible to `cargo test` (it
# passes 100% of the time in isolation) and only appears when two test binaries overlap, so the
# author of the offending line is the last person who would see it fail. Six crates carried it on
# 2026-08-31 and every failure it produced accused correct product code. 0.6s over the tree.
[[ -f scripts/check-test-temp-isolation.py ]] && run "test-temp-isolation" python3 scripts/check-test-temp-isolation.py
# Formatting drift, in the files this commit stages and nothing else. A whole-workspace
# `cargo fmt --all -- --check` read the working tree, so another session's untracked or unstaged
# `.rs` file -- an in-progress crate, a half-made edit -- blocked every unrelated commit, and the
# guard forbids `--no-verify` (2026-10-02). It also checked the working-tree copy rather than what
# is being committed, so a partially staged file was judged by its unstaged half.
#
# So the check reads each staged blob (`git show :<path>`) and pipes it through `rustfmt --emit
# stdout`, comparing bytes. `rustfmt --check` on stdin exits 0 even when it prints a diff
# (measured on rustfmt 1.10.0), hence the comparison rather than the exit code.
#
# Which files: only those `cargo fmt` itself formats, taken from `cargo fmt --all -- --check -v`
# ("Formatting <path>" for every file in a crate's module tree). That list matters: 78 tracked
# files are `include!` fragments and the like that cargo fmt never touches, and rustfmt on them
# alone disagrees with the committed bytes. Over the 671 files it does list, stdin rustfmt with the
# crate's edition matched HEAD byte for byte (measured 2026-10-02), so the two checks agree where
# both apply. Paths outside this repo -- the sibling `../fromsoftware-rs` path dependency -- never
# match a staged path (bd precommit-fmt-scope-staged-files-not-sibling-repo-2026-07-19). If cargo
# fmt lists nothing at all (a broken manifest), every staged file is checked rather than none.
rust_edition_for() {
	local dir edition
	dir="$(dirname -- "$1")"
	while :; do
		if [[ -f "$dir/Cargo.toml" ]]; then
			edition="$(sed -nE 's/^edition[[:space:]]*=[[:space:]]*"([0-9]+)".*/\1/p' "$dir/Cargo.toml" | head -n1)"
			if [[ -n "$edition" ]]; then
				echo "$edition"
				return
			fi
		fi
		[[ "$dir" == "." || "$dir" == "/" ]] && break
		dir="$(dirname -- "$dir")"
	done
	echo 2024
}

if grep -qE '\.rs$' <<<"$staged"; then
	declare -A cargo_fmt_covers=()
	while IFS= read -r line; do
		case "$line" in
		"Formatting $repo_root/"*) cargo_fmt_covers["${line#"Formatting $repo_root/"}"]=1 ;;
		esac
	done < <(cargo fmt --all -- --check -v 2>/dev/null || true)
	if [[ "${#cargo_fmt_covers[@]}" -eq 0 ]]; then
		echo "pre-commit: cargo fmt listed no files; checking every staged .rs file" >&2
	fi
	fmt_bad=""
	while IFS= read -r -d '' path; do
		if [[ "${#cargo_fmt_covers[@]}" -gt 0 && -z "${cargo_fmt_covers[$path]:-}" ]]; then
			continue
		fi
		edition="$(rust_edition_for "$path")"
		if ! fmt_diff="$(diff -u --label "a/$path" --label "b/$path" \
			<(git show ":$path") \
			<(git show ":$path" | rustfmt --edition "$edition" --emit stdout 2>&1))"; then
			fmt_bad+="$fmt_diff"$'\n'
		fi
	done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.rs')
	if [[ -n "$fmt_bad" ]]; then
		echo "pre-commit: FAIL [rustfmt on staged .rs files]" >&2
		while IFS= read -r line; do printf '    %s\n' "$line"; done <<<"$fmt_bad" >&2
		fail=1
	fi
fi

if [[ "$fail" -ne 0 ]]; then
	echo "pre-commit: blocked. Fix the above (a product FIX must be default-on on a real runtime" >&2
	echo "  condition -- no marker-file/env toggle), or 'git commit --no-verify' to bypass intentionally." >&2
	exit 1
fi
exit 0
