<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Voice chat with every player (Elden Ring 1.17.1)"</Description>
      <Options moHideChildren="0"/>
      <Color>0080FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[{ Elden Ring 1.17.1 voice chat for the whole session, invaders and hunters included.

  The game already records, sends and plays voice over its Steam session; Seamless Co-op
  rides the same sessions. This entry removes the two things that keep players apart:

  1. Voice chat is switched on: the Network option "Voice Chat" (GameSettings+0x14), and the
     two global flags every voice path checks first (eldenring.exe+3D7E89C and +3D7E89D,
     read by CSVoiceChatManager and never written by any code in the 1.17.1 image).

  2. Teams no longer mute each other. The game mutes a remote player whose
     RoleParam.voiceChatGroup shares no bit with yours (host and phantoms in one group,
     invaders in another). Two patches make that test always pass:
       eldenring.exe+CBBF25  xor bl,1 -> xor bl,bl   per-player mute decision
       eldenring.exe+9F9441  jz       -> nop nop     party "can voice chat" check (HUD icon)

  Every player who should hear and be heard needs the entry ticked: muting is decided on
  the listener's machine, and a player with voice off sends nothing.

  The asserts refuse any build but 1.17.1. Unticking restores every byte and value. }
[ENABLE]
assert(eldenring.exe+CBBF1B, 84 41 40 0F 95 C3 EB 02 32 DB 80 F3 01)
assert(eldenring.exe+9F943E, 84 41 40 74 22)

eldenring.exe+CBBF25:
  db 30 DB 90

eldenring.exe+9F9441:
  db 90 90

{$lua}
if syntaxcheck then return end
local function settings()
  local game_data_man = readPointer('eldenring.exe+3D61F98')
  if game_data_man == nil or game_data_man == 0 then return nil end
  local s = readPointer(game_data_man + 0x58)
  if s == nil or s == 0 then return nil end
  return s
end
er_voice_saved = er_voice_saved or {}
local saved = er_voice_saved
saved.flags = saved.flags or readBytes('eldenring.exe+3D7E89C', 2, true)
writeBytes('eldenring.exe+3D7E89C', 1, 1)
local s = settings()
if s ~= nil then
  if saved.option == nil then saved.option = readBytes(s + 0x14, 1) end
  writeBytes(s + 0x14, 1)
end
{$asm}

[DISABLE]
eldenring.exe+CBBF25:
  db 80 F3 01

eldenring.exe+9F9441:
  db 74 22

{$lua}
if syntaxcheck then return end
local saved = er_voice_saved or {}
if saved.flags ~= nil then writeBytes('eldenring.exe+3D7E89C', saved.flags) end
if saved.option ~= nil then
  local game_data_man = readPointer('eldenring.exe+3D61F98')
  local s = game_data_man and game_data_man ~= 0 and readPointer(game_data_man + 0x58)
  if s and s ~= 0 then writeBytes(s + 0x14, saved.option) end
end
er_voice_saved = nil
{$asm}
]]></AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1</ID>
          <Description>"Voice Chat option (1 = on)"</Description>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>eldenring.exe+3D61F98</Address>
          <Offsets>
            <Offset>14</Offset>
            <Offset>58</Offset>
          </Offsets>
        </CheatEntry>
        <CheatEntry>
          <ID>2</ID>
          <Description>"Voice system flag A (1 = on)"</Description>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>eldenring.exe+3D7E89C</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>3</ID>
          <Description>"Voice system flag B (1 = on)"</Description>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>eldenring.exe+3D7E89D</Address>
        </CheatEntry>
        <CheatEntry>
          <ID>4</ID>
          <Description>"Voice chat running (1 = mic live this frame)"</Description>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>eldenring.exe+3D7E540</Address>
          <Offsets>
            <Offset>8</Offset>
            <Offset>40</Offset>
          </Offsets>
        </CheatEntry>
        <CheatEntry>
          <ID>5</ID>
          <Description>"Voice chat manager enabled (+9, 1 = yes)"</Description>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>eldenring.exe+3D7E540</Address>
          <Offsets>
            <Offset>9</Offset>
            <Offset>40</Offset>
          </Offsets>
        </CheatEntry>
        <CheatEntry>
          <ID>6</ID>
          <Description>"Voice chat manager suspended (+A, 0 = no)"</Description>
          <ShowAsSigned>0</ShowAsSigned>
          <VariableType>Byte</VariableType>
          <Address>eldenring.exe+3D7E540</Address>
          <Offsets>
            <Offset>A</Offset>
            <Offset>40</Offset>
          </Offsets>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
  <Comments>Elden Ring 1.17.1 voice chat for every player in a session, Seamless Co-op included. Every player ticks the entry. Static RE: scripts/cheat-engine/README.md (er-voice-chat.CT).</Comments>
</CheatTable>
