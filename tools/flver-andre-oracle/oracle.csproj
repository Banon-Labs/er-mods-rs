<!-- Dev-only FLVER oracle over Smithbox's Andre.SoulsFormats; see Program.cs. Smithbox is a
     binary install, resolved from $SMITHBOX_DIR or $HOME/.local/share/smithbox/app. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>flver-andre-oracle</AssemblyName>
    <SmithboxDir>$(SMITHBOX_DIR)</SmithboxDir>
    <SmithboxDir Condition="'$(SmithboxDir)' == ''">$(HOME)/.local/share/smithbox/app</SmithboxDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Andre.Core"><HintPath>$(SmithboxDir)/Andre.Core.dll</HintPath></Reference>
    <Reference Include="Andre.SoulsFormats"><HintPath>$(SmithboxDir)/Andre.SoulsFormats.dll</HintPath></Reference>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
  </ItemGroup>
</Project>
